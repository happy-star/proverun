# Copy to .env for local overrides. Never commit a real key.
# Leave VULTR_INFERENCE_API_KEY empty to use deterministic mock inference.

PORT=8787

# Vultr Serverless Inference — OpenAI-compatible.
# https://api.vultrinference.com/v1/chat/completions
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017

# Sandbox. The image is pulled by the Docker daemon, not baked into the API image.
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SEC=20
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
MAX_CSV_BYTES=200000

# Optional SERV audit. Leave the key empty to disable it.
# A run calls SERV only when the client sends {"audit": true}.
# Model id from the SERV chat-completions docs. Do not commit a real key.
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_MODEL=gpt-5.4-mini
SERV_TIMEOUT_MS=12000
SERV_MAX_COMPLETION_TOKENS=500
